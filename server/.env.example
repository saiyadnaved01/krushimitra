PORT=4000
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Origin allowed by CORS when the client runs on a different port (development only)
CLIENT_ORIGIN=http://localhost:5173

# --- Demo data (development only) -------------------------------------------------
# In production both default to false: no demo accounts are created and demo sign-in is off.
# ALLOW_DEMO_LOGIN=true
# SEED_DEMO_DATA=true

# --- First administrator (use for a new, empty production database) -------------
# Created once at startup if no account with this email exists. Existing accounts are never changed.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-a-long-password   (min 8 characters)
# ADMIN_NAME=Administrator

# --- Deployment -------------------------------------------------------------------
# Set to 1 when behind one reverse proxy / load balancer so rate limiting sees real client IPs.
# TRUST_PROXY=1
# Requests per 15 minutes per IP for the whole API (default 600 in production)
# API_RATE_LIMIT=600

# SQLite database file (created, migrated and seeded on first run)
# DATABASE_FILE=./data/krushimitra.db
# open-meteo = live forecast + observed climate (no API key); sample = offline
WEATHER_PROVIDER=open-meteo
